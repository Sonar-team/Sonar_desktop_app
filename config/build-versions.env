# Canonical build and CI toolchain versions.
#
# Update this file first when bumping build tooling. Files that cannot source it
# directly, such as `src-tauri/rust-toolchain.toml`, `package.json`, and
# `Dockerfile`, must be kept aligned with these values.

RUST_VERSION=1.97.1
RUST_IMAGE_DIGEST=sha256:1bcff4befb740599103a2c7cb51058e14479b2e35e3a34a3f0dc4ede09927488
# The Tarpaulin image embeds this dated nightly. Coverage and cargo-udeps both
# select it explicitly, and its compiler must satisfy RUST_VERSION.
RUST_NIGHTLY_VERSION=nightly-2026-07-29
TARPAULIN_IMAGE=xd009642/tarpaulin:develop-nightly
TARPAULIN_IMAGE_DIGEST=sha256:c6f519f6098d2e0a2036d119e17b3fa1e3de7270801ce03cbff0281c72d872a3
DOCKERFILE_FRONTEND_VERSION=1.25.0
DOCKERFILE_FRONTEND_DIGEST=sha256:0adf442eae370b6087e08edc7c50b552d80ddf261576f4ebd6421006b2461f12
DOCKER_BUILD_PLATFORM=linux/amd64
NODE_VERSION=24.15.0
DENO_VERSION=2.8.3
TAURI_CLI_VERSION=2.11.3
VITE_VERSION=8.0.16
CARGO_CYCLONEDX_VERSION=0.5.9
CARGO_VET_VERSION=0.10.2
# Fuzzing borné en CI (#151) : cargo-fuzz s'appuie sur RUST_NIGHTLY_VERSION.
CARGO_FUZZ_VERSION=0.13.2
CARGO_XWIN_VERSION=0.23.0
# cargo-xwin 0.23.0 verrouille xwin 0.9.0 dans son Cargo.lock. Ces trois
# valeurs sélectionnent explicitement le manifeste Visual Studio, le SDK et
# le CRT Microsoft au lieu des valeurs « latest » non reproductibles.
XWIN_VERSION=17
XWIN_SDK_VERSION=10.0.26100
XWIN_CRT_VERSION=14.44.17.14
XWIN_ARCH=x86_64
XWIN_HTTP_RETRIES=5
SYFT_VERSION=1.46.0
COSIGN_VERSION=3.0.6
SIGSTORE_TRUSTED_ROOT_SHA256=6494e21ea73fa7ee769f85f57d5a3e6a08725eae1e38c755fc3517c9e6bc0b66

UBUNTU_RUNNER=ubuntu-22.04
WINDOWS_RUNNER=windows-2022
MACOS_RUNNER=macos-14
MACOS_TARGET=x86_64-apple-darwin

APT_SNAPSHOT_TIMESTAMP=20260707T000000Z
DEBIAN_SNAPSHOT_BASE_URL=https://snapshot.debian.org/archive
UBUNTU_SNAPSHOT_BASE_URL=https://snapshot.ubuntu.com/ubuntu

LINUX_APT_PACKAGES="libwebkit2gtk-4.1-dev=2.50.4-0ubuntu0.22.04.1 libappindicator3-dev=12.10.1+20.10.20200706.1-0ubuntu1 librsvg2-dev=2.52.5+dfsg-3ubuntu0.2 patchelf=0.14.3-1 libpcap-dev=1.10.1-4ubuntu1.22.04.1"
GITLAB_APT_PACKAGES="libgtk-3-dev=3.24.49-3 pkg-config=1.8.1-4 libjavascriptcoregtk-4.1-dev=2.52.5-1~deb13u1 libsoup-3.0-dev=3.6.5-3 libwebkit2gtk-4.1-dev=2.52.5-1~deb13u1 libpcap-dev=1.10.5-2 xz-utils=5.8.1-1"
DOCKER_APT_PACKAGES="libgtk-3-dev=3.24.49-3 pkg-config=1.8.1-4 libjavascriptcoregtk-4.1-dev=2.52.5-1~deb13u1 libsoup-3.0-dev=3.6.5-3 libwebkit2gtk-4.1-dev=2.52.5-1~deb13u1 libpcap-dev=1.10.5-2 unzip"
WINDOWS_CROSS_APT_PACKAGES="clang=1:19.0-63 clang-tools=1:19.0-63 lld=1:19.0-63 llvm=1:19.0-63 nsis=3.11-1"
